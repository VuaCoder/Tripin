{
  "info": {
    "name": "Tripri Auth API - Standard",
    "description": "Postman Collection for Tripri Authentication endpoints. Uses variables for consistency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "testEmail",
      "value": "user@tripri.local"
    },
    {
      "key": "testPassword",
      "value": "MyPassword123!"
    }
  ],
  "item": [
    {
      "name": "1. Register (Tạo tài khoản mới)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Tự động tạo email ngẫu nhiên để không bị trùng lặp",
              "pm.collectionVariables.set(\"testEmail\", \"user_\" + pm.variables.replaceIn('{{$randomInt}}') + \"@tripri.local\");",
              "pm.collectionVariables.set(\"testPassword\", \"MyPassword123!\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/api/v1/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Nguyen Van Test\",\n  \"role\": \"TRAVELER\"\n}"
        }
      }
    },
    {
      "name": "2. Verify OTP (Điền mã OTP thủ công)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/api/v1/auth/verify-otp",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "api",
            "v1",
            "auth",
            "verify-otp"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"123456\",\n  \"purpose\": \"REGISTER\"\n}"
        }
      }
    },
    {
      "name": "3. Login (Đăng nhập)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/api/v1/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        }
      }
    },
    {
      "name": "4. Get Current Profile (Test tính năng khác bằng Token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <DÁN_ACCESS_TOKEN_CỦA_BẠN_VÀO_ĐÂY>"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/api/v1/users/me",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "api",
            "v1",
            "users",
            "me"
          ]
        }
      }
    }
  ]
}
