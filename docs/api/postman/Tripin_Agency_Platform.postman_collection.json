{
  "info": {
    "_postman_id": "a98e2170-1f0b-4874-9efc-7a9893d56a21",
    "name": "Tripri - Agency Portal & Tour Management API",
    "description": "Comprehensive Postman Collection verifying all Acceptance Criteria for Agency Tour Management & Operations:\n- Create, Edit, Delete, Import Tour\n- Configure Itinerary & Availability\n- Dashboard Metrics, Bookings Status, Export Customer PDF\n- Assign Guide to Tour & Cross-Agency Isolation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001/api/v1",
      "type": "string"
    },
    {
      "key": "agency_email",
      "value": "demo.heritage@tripri.local",
      "type": "string"
    },
    {
      "key": "agency_password",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "agency_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tour_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "3fad3fdb-80a6-4082-a7b4-510b5aa0437b",
      "type": "string"
    },
    {
      "key": "guide_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Agency Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('agency_token', res.data.accessToken);",
                  "    console.log('Saved agency_token:', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{agency_email}}\",\n  \"password\": \"{{agency_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/agency/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "agency", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Mục tiêu 1 - Tour Management",
      "item": [
        {
          "name": "1. Create Tour (DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Tour starts as DRAFT', () => pm.expect(res.data.status).to.eql('DRAFT'));",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('tour_id', res.data.id);",
                  "    console.log('Created tour_id:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hành trình khám phá Đảo Ngọc Phú Quốc 3N2Đ\",\n  \"destination\": \"Phú Quốc\",\n  \"durationDays\": 3,\n  \"basePrice\": 3200000,\n  \"maxGroupSize\": 25,\n  \"categoryIds\": [\"{{category_id}}\"],\n  \"images\": [\n    \"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80\"\n  ],\n  \"summary\": \"Trải nghiệm lặn ngắm san hô và ẩm thực biển tươi ngon.\",\n  \"description\": \"Chi tiết chương trình tham quan các đảo đẹp nhất Nam Phú Quốc...\",\n  \"inclusions\": [\n    \"Xe đưa đón đời mới\",\n    \"Khách sạn 4 sao gần biển\",\n    \"Bảo hiểm du lịch trọn gói\"\n  ],\n  \"exclusions\": [\n    \"Chi tiêu cá nhân ngoài chương trình\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/tours",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours"]
            }
          }
        },
        {
          "name": "2. List Own Tours (Pagination & Filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/tours?page=1&limit=10&status=DRAFT",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "DRAFT" }
              ]
            }
          }
        },
        {
          "name": "3. Get Own Tour Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}"]
            }
          }
        },
        {
          "name": "4. Edit Tour Information",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"[Cập nhật] Tour Phú Quốc Đảo Ngọc 3N2Đ Siêu Ưu Đãi\",\n  \"basePrice\": 3100000\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}"]
            }
          }
        },
        {
          "name": "5. Configure Itinerary",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": [\n    {\n      \"day\": 1,\n      \"title\": \"Đón khách - Khám phá Đông Đảo\",\n      \"description\": \"Xe đón tại sân bay Phú Quốc, nhận phòng khách sạn, tham quan Dinh Cậu.\",\n      \"activities\": [\"Đón sân bay\", \"Check-in khách sạn\", \"Ngắm hoàng hôn Dinh Cậu\"]\n    },\n    {\n      \"day\": 2,\n      \"title\": \"Tour 4 Đảo Cano & Cáp treo Hòn Thơm\",\n      \"description\": \"Lặn ngắm san hô tại hòn Mây Rút, trải nghiệm cáp treo vượt biển dài nhất thế giới.\",\n      \"activities\": [\"Đi cano cao tốc\", \"Lặn ngắm san hô\", \"Buffet Hòn Thơm\"]\n    },\n    {\n      \"day\": 3,\n      \"title\": \"Mua sắm đặc sản - Tiễn sân bay\",\n      \"description\": \"Tham quan vườn tiêu, cơ sở ngọc trai và tiễn đoàn ra sân bay.\",\n      \"activities\": [\"Mua sắm đặc sản\", \"Check-out\", \"Tiễn sân bay\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}/itinerary",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}", "itinerary"]
            }
          }
        },
        {
          "name": "6. Set Availability (Departures)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departures\": [\n    {\n      \"date\": \"2026-11-20T00:00:00.000Z\",\n      \"capacity\": 20,\n      \"isOpen\": true\n    },\n    {\n      \"date\": \"2026-11-27T00:00:00.000Z\",\n      \"capacity\": 25,\n      \"isOpen\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}/availability",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}", "availability"]
            }
          }
        },
        {
          "name": "7. Upload / Bulk Import Tours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tours\": [\n    {\n      \"title\": \"Hành trình trekking Tà Năng 2N1Đ\",\n      \"destination\": \"Lâm Đồng\",\n      \"durationDays\": 2,\n      \"basePrice\": 1850000,\n      \"categoryIds\": [\"{{category_id}}\"],\n      \"images\": [\"https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&w=800&q=80\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/tours/import",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "import"]
            }
          }
        },
        {
          "name": "8. Delete Tour (Soft Delete / Archive)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Mục tiêu 2 - Operations, Dashboard & Bookings",
      "item": [
        {
          "name": "1. View Agency Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Contains agency metrics', () => {",
                  "    pm.expect(res.data).to.have.property('tours');",
                  "    pm.expect(res.data).to.have.property('bookings');",
                  "    pm.expect(res.data).to.have.property('revenue');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/dashboard",
              "host": ["{{base_url}}"],
              "path": ["agency", "dashboard"]
            }
          }
        },
        {
          "name": "2. View Bookings Status & List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('booking_id', res.data[0].id);",
                  "    console.log('Saved booking_id:', res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/bookings?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["agency", "bookings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "3. Search Available Tour Guides",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('guide_id', res.data[0].id);",
                  "    console.log('Saved guide_id:', res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/guides?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["agency", "guides"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "4. Assign Guide to Tour",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guideId\": \"{{guide_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}/guide",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}", "guide"]
            }
          }
        },
        {
          "name": "5. Export Customer PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/tours/{{tour_id}}/customers.pdf",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "{{tour_id}}", "customers.pdf"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Security & Isolation Tests",
      "item": [
        {
          "name": "Cross-Agency Tour Access (Expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cross agency access returns 404 Not Found', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/tours/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["agency", "tours", "00000000-0000-0000-0000-000000000000"]
            }
          }
        },
        {
          "name": "Cross-Agency Booking Access (Expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cross agency booking returns 404 Not Found', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agency_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency/bookings/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["agency", "bookings", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
    }
  ]
}
