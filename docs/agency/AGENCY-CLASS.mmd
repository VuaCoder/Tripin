class AgencyController {
  <<Controller>>
  +Router identityRouter
  +Router invitationRouter
  +Router foundationRouter
  +List~AgencyMembershipDto~ listMyAgencies(UUID userId)
  +AgencyContext getContext(AgencyContext ctx)
  +List~AgencyMemberView~ listMembers(AgencyContext ctx)
  +List~AgencyRole~ listRoles(AgencyContext ctx)
  +AgencyRole createRole(AgencyContext ctx, RoleRequestDTO body)
  +AgencyRole updateRole(AgencyContext ctx, UUID roleId, RoleRequestDTO body)
  +AgencyMember setMemberAccess(AgencyContext ctx, UUID memberId, MemberAccessRequestDTO body)
  +AgencyMember setTourScopes(AgencyContext ctx, UUID memberId, List~TourScopeRequestDTO~ body)
  +AgencyInvitation inviteMember(AgencyContext ctx, InviteRequestDTO body)
  +boolean revokeInvitation(AgencyContext ctx, UUID invitationId)
  +AgencyMember changeMember(AgencyContext ctx, UUID memberId, String role, String status)
  +InvitationValidationResult validateInvitation(String token, String emailHint)
  +AgencyMember acceptInvitation(UUID userId, String token)
  +AgencyMember acceptInvitationById(UUID userId, UUID invitationId)
  -void validationErrorHandler(Error error)
}

class AgencyService {
  <<Service>>
  -String digest(String token)
  -String maskEmail(String email)
  +List~AgencyMembershipDto~ listForUser(UUID userId)
  +AgencyContext resolve(UUID userId, UUID selectedAgencyId)
  +AgencyContext resolveOptional(UUID userId, UUID selectedAgencyId)
  +AgencyMember changeMember(AgencyContext ctx, UUID memberId, String role, String status)
  +AgencyInvitation invite(AgencyContext ctx, InviteRequestDTO input)
  +AgencyMember accept(UUID userId, String token)
  +List~AgencyInvitation~ myInvitations(UUID userId, int page)
  +AgencyMember acceptById(UUID userId, UUID invitationId)
  +InvitationValidationResult validateInvitationToken(String token, String emailHint)
  +boolean revoke(AgencyContext ctx, UUID invitationId)
}

class AgencyAccessService {
  <<Service>>
  +List~AgencyRole~ listRoles(AgencyContext ctx)
  +AgencyRole saveRole(AgencyContext ctx, RoleRequestDTO input, UUID roleId)
  +AgencyMember setMemberAccess(AgencyContext ctx, UUID memberId, MemberAccessRequestDTO input)
}

class AgencyWorkService {
  <<Service>>
  +AgencyMember setTourScopes(AgencyContext ctx, UUID memberId, List~TourScopeRequestDTO~ scopes)
  +Tour updateScopedContent(AgencyContext ctx, UUID tourId, ContentPatchDTO patch)
}

class WorkplacesService {
  <<Service>>
  -User activeUser(DbExecutor tx, UUID userId)
  +AgencyProfile create(UUID userId, AgencyApplicationInput input, UUID requestId)
  +AgencyProfile application(AgencyContext ctx)
  +AgencyProfile saveApplication(AgencyContext ctx, AgencyApplicationInput input, boolean submit)
  +AgencyJoinCode currentCode(AgencyContext ctx)
  +AgencyJoinCode rotateCode(AgencyContext ctx)
  +boolean revokeCode(AgencyContext ctx, UUID codeId)
  +AgencyJoinRequest request(UUID userId, String code)
  +List~AgencyJoinRequest~ mine(UUID userId, int page)
  +List~AgencyJoinRequest~ queue(AgencyContext ctx, int page)
  +boolean cancel(UUID userId, UUID requestId)
  +AgencyMember review(AgencyContext ctx, UUID requestId, UUID roleId)
}

class AgencyGuard {
  <<Utility>>
  +AgencyMember lockAgencyAccess(DbExecutor tx, AgencyContext ctx, AgencyPermission permission)$
  +void assertDelegable(AgencyMember actor, List~AgencyPermission~ permissions)$
  +void bumpAgencyPermissions(DbExecutor tx, UUID agencyId)$
  +AgencyMember lockWorkplaceOwner(DbExecutor tx, AgencyContext ctx)$
  +AgencyMember joinOrRestoreAgencyMember(DbExecutor tx, UUID agencyId, UUID userId)$
}

class AgencyPolicy {
  <<Utility>>
  +List~AgencyPermission~ AGENCY_PERMISSION_CATALOG$
  +Map AGENCY_ROLE_PERMISSIONS$
  +List~AgencyPermission~ effectiveAgencyPermissions(PermissionSource member)$
}

class AgencyProfileRepository {
  <<Repository>>
  +AgencyPublicProfileDto publicProfile(UUID agencyId)
  +Page~AgencyModerationDto~ list(String status, PageQuery page)
  +AgencyModerationDto decide(ModeratorActor actor, UUID agencyId, DecisionDTO decision)
}

class PrismaClient {
  <<DAO>>
  +AgencyProfile agencyProfile
  +AgencyMember agencyMember
  +AgencyRole agencyRole
  +AgencyInvitation agencyInvitation
