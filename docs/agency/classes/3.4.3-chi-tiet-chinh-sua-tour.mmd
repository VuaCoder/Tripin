classDiagram
%% 3.4.3 Chi tiet va chinh sua tour
%% GET /agency/tours/:id, PATCH /agency/tours/:id

class ToursController {
  <<Controller>>
  +getOwn(AgencyContext ctx, UUID id) TourManageDto
  +update(AgencyContext ctx, UUID id, UpdateTourInput body) TourManageDto
}

class ToursService {
  <<Service>>
  +getOwn(UUID agencyId, UUID id) TourManageDto
  +updateTour(UUID agencyId, UUID id, UpdateTourInput input, AgencyMemberRole memberRole) TourManageDto
}

class ToursRepository {
  <<Repository>>
  +findById(UUID id) TourRecord
  +updateIfStatus(UUID id, List~TourStatus~ expected, TourPatch patch, AuditEntry audit) TourRecord
}

class PrismaClient {
  <<DAO>>
  +Tour tour
}

class Tour {
  +UUID id
  +UUID agencyId
  +String title
  +String summary
  +String description
  +BigInt basePrice
  +String status
  +int updatedAt
}

class AgencyMemberTourScope {
  +UUID memberId
  +UUID tourId
  +List~String~ allowedFields
}

class UpdateTourInput {
  <<DTO>>
  +String title
  +String summary
  +String description
  +BigInt basePrice
}

class TourManageDto {
  <<DTO>>
  +UUID id
  +String title
  +String status
  +int itineraryDays
}

ToursController "1" ..> "1" ToursService : delegates
ToursController ..> "1" UpdateTourInput : validates
ToursService "1" --> "1" Tour : reads and writes
ToursService ..> "1" ToursRepository : persists
ToursService ..> "1" TourManageDto : maps
ToursRepository ..> "1" PrismaClient : uses
AgencyMemberTourScope "*" --> "1" Tour : scopes
UpdateTourInput ..> "1" Tour : patches
Tour ..> "1" TourManageDto : projected to
