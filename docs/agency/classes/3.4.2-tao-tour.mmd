classDiagram
%% 3.4.2 Tao tour
%% POST /agency/tours, POST /agency/tours/upload-image

class ToursController {
  <<Controller>>
  +create(AgencyContext ctx, TourContentInput body) TourManageDto
  +uploadImage(Request req) ImageUploadSignature
}

class ToursService {
  <<Service>>
  +createTour(UUID agencyId, TourContentInput input) TourManageDto
}

class ToursRepository {
  <<Repository>>
  +create(NewTour data) TourRecord
  +findRecentDraft(UUID agencyId, String title, String destination, int windowMs) TourRecord
}

class PrismaClient {
  <<DAO>>
  +Tour tour
}

class Tour {
  +UUID id
  +UUID agencyId
  +String title
  +String destination
  +int durationDays
  +BigInt basePrice
  +List~String~ images
  +String status
}

class TourContentInput {
  <<DTO>>
  +String title
  +String destination
  +int durationDays
  +BigInt basePrice
  +List~String~ images
}

class TourManageDto {
  <<DTO>>
  +UUID id
  +String title
  +String status
  +Date createdAt
}

ToursController "1" ..> "1" ToursService : delegates
ToursController ..> "1" TourContentInput : validates
ToursController "1" ..> "1" TourManageDto : returns
ToursService "1" --> "*" Tour : creates
ToursService ..> "1" ToursRepository : persists
ToursService ..> "1" TourManageDto : maps
ToursRepository ..> "1" PrismaClient : uses
TourContentInput ..> "1" Tour : becomes
Tour ..> "1" TourManageDto : projected to
