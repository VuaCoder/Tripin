classDiagram
%% 3.17.4 Cach ly du lieu giua cac agency
%% Moi truy van tenant deu loc theo AgencyContext.agencyId

class AgencyContextMiddleware {
  <<Middleware>>
  +resolveAgencyContext(Request req) void
  +requireAgencyPermission(AgencyPermission permission) RequestHandler
}

class AgencyPolicy {
  <<Utility>>
  +effectiveAgencyPermissions(PermissionSource member) List~AgencyPermission~$
  +List~AgencyPermission~ AGENCY_PERMISSION_CATALOG$
}

class AgencyGuard {
  <<Utility>>
  +AgencyMember lockAgencyAccess(DbExecutor tx, AgencyContext ctx, AgencyPermission permission)$
}

class AgencyContext {
  <<DTO>>
  +UUID agencyId
  +UUID actorUserId
  +UUID memberId
  +AgencyMemberRole memberRole
  +List~AgencyPermission~ permissions
}

class PrismaClient {
  <<DAO>>
  +AgencyProfile agencyProfile
  +AgencyMember agencyMember
  +Tour tour
  +Booking booking
}

class AgencyProfile {
  +UUID id
  +String companyName
  +int permissionVersion
}

class AgencyMember {
  +UUID id
  +UUID agencyId
  +UUID userId
  +AgencyMemberRole role
}

class Tour {
  +UUID id
  +UUID agencyId
  +String title
}

class Booking {
  +UUID id
  +UUID agencyId
  +String bookingCode
}

AgencyContextMiddleware "1" ..> "1" AgencyContext : attaches single tenant
AgencyContextMiddleware ..> "1" AgencyPolicy : resolves grants
AgencyPolicy ..> "1" AgencyMember : derives permissions
AgencyContext ..> "1" AgencyMember : identifies membership
AgencyGuard ..> "1" AgencyContext : re-checks after lock
AgencyGuard ..> "1" PrismaClient : locks agency row
AgencyProfile "1" *-- "1..*" AgencyMember : scopes
AgencyProfile "1" o-- "*" Tour : owns
AgencyProfile "1" o-- "*" Booking : owns
