//////////////////////////////////////////////
// TABLE GROUPS
//////////////////////////////////////////////

TableGroup "Danh tính & tài khoản" {
  "User"
  "AgencyProfile"
  "GuideProfile"
  "Otp"
  "RefreshToken"
}

TableGroup "Danh mục & tour" {
  "Category"
  "Tour"
  "TourDeparture"
  "TourGuideAssignment"
  "_CategoryToTour"
}

TableGroup "Đặt chỗ & tiền" {
  "Booking"
  "Payment"
  "ETicket"
  "Earning"
  "Promotion"
  "SubscriptionPlan"
