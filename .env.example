# Application
NODE_ENV=development
PORT=3001
# Comma separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Periodic sweeps (booking/payment/subscription expiry...). Set false on nodes that must not run them.
JOBS_ENABLED=true

# PostgreSQL
DATABASE_URL=
# TEMPORARY: current backend code still uses Mongoose; remove together with the Mongoose -> Prisma migration
MONGODB_URI=

# JWT (use two different random strings, >= 32 chars in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
# lax | strict | none  (none requires HTTPS)
COOKIE_SAME_SITE=lax

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / OTP (leave SMTP_HOST empty in development to print emails to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tripri <no-reply@tripri.local>

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional; defaults to <first CLIENT_URL>/payment/success and /payment/cancel
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=

# AI (AI_PROVIDER: disabled | anthropic)
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

# Seed script (`pnpm --filter backend seed`): first SUPER_ADMIN + default categories/plans. No default password exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Optional initial platform commission in percent (applied only if none was ever saved)
SEED_COMMISSION_PERCENT=
