# Application
NODE_ENV=development
PORT=3001
# Comma separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Periodic sweeps (booking/payment/subscription expiry...). Set false on nodes that must not run them.
JOBS_ENABLED=true

# Database Options:
# Option 1: Neon Cloud PostgreSQL (Khuyên dùng cho Team để đồng bộ dữ liệu không cần cài Postgres local)
# DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/<dbname>?channel_binding=require&sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<neon-direct-host>/<dbname>?channel_binding=require&sslmode=require"
# NEON_BRANCH=production

# Option 2: Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_platform

# JWT (Bắt buộc >= 16 ký tự ở dev, >= 32 ký tự ở production)
JWT_ACCESS_SECRET=dev_tripri_jwt_access_secret_32_characters_long_key_demo
JWT_REFRESH_SECRET=dev_tripri_jwt_refresh_secret_32_characters_long_key_demo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
# lax | strict | none (none requires HTTPS)
COOKIE_SAME_SITE=lax

# Google OAuth (Tuỳ chọn trong môi trường dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend (put in frontend/.env.local): same value as GOOGLE_CLIENT_ID; public by design
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email / OTP (Ưu tiên BREVO_API_KEY gửi qua Brevo HTTPS API, hoặc SMTP_HOST)
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tripri <no-reply@tripri.com>

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional; defaults to <first CLIENT_URL>/payment/success and /payment/cancel
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=

# AI (AI_PROVIDER: disabled | anthropic)
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

# Seed script (`pnpm --filter backend seed`): first SUPER_ADMIN + default categories/plans
SEED_ADMIN_EMAIL=admin@tripri.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_NAME=Super Admin
# Optional initial platform commission in percent (applied only if none was ever saved)
SEED_COMMISSION_PERCENT=10
